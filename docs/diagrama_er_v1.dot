digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.45", ranksep="1.1", fontname="Arial", labelloc=t, label="SmartConnect - Diagrama ER v1 previsto\nAzul: implementado (Persona y Terreno). Gris: previsto para siguientes entregas.\nPK: clave primaria | FK: clave foranea | UK: valor unico | Cardinalidades en ambos extremos", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, labelfontsize=11, color="#64748b", fontcolor="#334155", dir=none, labeldistance=1.6];
PERSONA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>PERSONA</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">string codigo UK</TD></TR><TR><TD ALIGN="LEFT">string nombres</TD></TR><TR><TD ALIGN="LEFT">string apellidos</TD></TR><TR><TD ALIGN="LEFT">string email UK</TD></TR></TABLE>>];
TERRENO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>TERRENO</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">string codigo UK</TD></TR><TR><TD ALIGN="LEFT">string nombre</TD></TR><TR><TD ALIGN="LEFT">string direccion</TD></TR><TR><TD ALIGN="LEFT">bigint administrador_id FK</TD></TR></TABLE>>];
VIVIENDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>VIVIENDA</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">bigint terreno_id FK</TD></TR><TR><TD ALIGN="LEFT">string identificador</TD></TR><TR><TD ALIGN="LEFT">string tipo</TD></TR></TABLE>>];
PARTICIPACION_VIVIENDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>PARTICIPACION_VIVIENDA</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">bigint persona_id FK</TD></TR><TR><TD ALIGN="LEFT">bigint vivienda_id FK</TD></TR><TR><TD ALIGN="LEFT">string rol</TD></TR><TR><TD ALIGN="LEFT">boolean activa</TD></TR></TABLE>>];
TRABAJADOR_TERRENO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>TRABAJADOR_TERRENO</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">bigint persona_id FK</TD></TR><TR><TD ALIGN="LEFT">bigint terreno_id FK</TD></TR><TR><TD ALIGN="LEFT">string funcion</TD></TR><TR><TD ALIGN="LEFT">boolean activo</TD></TR></TABLE>>];
CREDENCIAL [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>CREDENCIAL</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">string uid UK</TD></TR><TR><TD ALIGN="LEFT">bigint persona_id FK</TD></TR><TR><TD ALIGN="LEFT">string estado</TD></TR></TABLE>>];
PUNTO_ACCESO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>PUNTO_ACCESO</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">bigint terreno_id FK</TD></TR><TR><TD ALIGN="LEFT">bigint vivienda_id FK nullable</TD></TR><TR><TD ALIGN="LEFT">string nombre</TD></TR><TR><TD ALIGN="LEFT">string tipo</TD></TR><TR><TD ALIGN="LEFT">boolean activo</TD></TR></TABLE>>];
AUTORIZACION_ACCESO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>AUTORIZACION_ACCESO</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">bigint persona_id FK</TD></TR><TR><TD ALIGN="LEFT">bigint punto_acceso_id FK</TD></TR><TR><TD ALIGN="LEFT">boolean activa</TD></TR></TABLE>>];
INTENTO_ACCESO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#f1f5f9"><B>INTENTO_ACCESO</B></TD></TR><TR><TD ALIGN="LEFT">bigint id PK</TD></TR><TR><TD ALIGN="LEFT">bigint punto_acceso_id FK</TD></TR><TR><TD ALIGN="LEFT">bigint persona_id FK nullable</TD></TR><TR><TD ALIGN="LEFT">bigint credencial_id FK nullable</TD></TR><TR><TD ALIGN="LEFT">string medio</TD></TR><TR><TD ALIGN="LEFT">string uid_recibido nullable para APP</TD></TR><TR><TD ALIGN="LEFT">datetime fecha_hora</TD></TR><TR><TD ALIGN="LEFT">string resultado</TD></TR><TR><TD ALIGN="LEFT">string motivo</TD></TR><TR><TD ALIGN="LEFT">string estado_dispositivo</TD></TR><TR><TD ALIGN="LEFT">string contexto_proximidad</TD></TR></TABLE>>];
PERSONA -> TERRENO [label="administra", taillabel="1", headlabel="0..N"];
TERRENO -> VIVIENDA [label="contiene", taillabel="1", headlabel="0..N"];
PERSONA -> PARTICIPACION_VIVIENDA [label="participa", taillabel="1", headlabel="0..N"];
VIVIENDA -> PARTICIPACION_VIVIENDA [label="tiene", taillabel="1", headlabel="0..N"];
PERSONA -> TRABAJADOR_TERRENO [label="trabaja", taillabel="1", headlabel="0..N"];
TERRENO -> TRABAJADOR_TERRENO [label="emplea", taillabel="1", headlabel="0..N"];
PERSONA -> CREDENCIAL [label="posee", taillabel="1", headlabel="0..N"];
TERRENO -> PUNTO_ACCESO [label="contiene", taillabel="1", headlabel="0..N"];
VIVIENDA -> PUNTO_ACCESO [label="vincula opcionalmente", taillabel="0..1", headlabel="0..N"];
PERSONA -> AUTORIZACION_ACCESO [label="recibe", taillabel="1", headlabel="0..N"];
PUNTO_ACCESO -> AUTORIZACION_ACCESO [label="habilita", taillabel="1", headlabel="0..N"];
PUNTO_ACCESO -> INTENTO_ACCESO [label="registra", taillabel="1", headlabel="0..N"];
PERSONA -> INTENTO_ACCESO [label="identificada", taillabel="0..1", headlabel="0..N"];
CREDENCIAL -> INTENTO_ACCESO [label="utilizada", taillabel="0..1", headlabel="0..N"];
}